extends SceneTree

const Rules = preload("res://scripts/rules.gd")

func _init() -> void:
	assert(not Rules.ball_outside(Vector3(7.4, 1, 6.7)))
	assert(Rules.ball_outside(Vector3(7.6, 1, 0)))
	assert(Rules.ball_outside(Vector3(0, 1, 6.8)))
	assert(Rules.clamp_to_court(Vector3(20, 0, 20)).is_equal_approx(Vector3(7.2, 0, 6.475)))
	assert(Rules.shot_points(Vector3(6.61, 0, -6)) == 3)
	assert(Rules.shot_points(Vector3(6.59, 0, -6)) == 2)
	assert(Rules.shot_points(Vector3(0, 0, 1.11)) == 3)
	assert(Rules.shot_points(Vector3(0, 0, 1.09)) == 2)
	assert(Rules.finish_type(Vector3(0, 0, -4), Vector2(0, -4)) == "dunk")
	assert(Rules.finish_type(Vector3(0, 0, -4), Vector2.ZERO) == "layup")
	assert(Rules.finish_type(Vector3(0, 0, -4), Vector2(4, 0)) == "layup")
	assert(Rules.finish_type(Vector3(0, 0, -4), Vector2(0, 4)) == "layup")
	assert(Rules.finish_type(Vector3(0, 0, -2.5), Vector2(0, -4)) == "shot")
	assert(Rules.finish_type(Vector3(0, 0, -6), Vector2(0, 4)) == "shot")
	assert(Rules.release_bonus(0.42) > Rules.release_bonus(0.62))
	assert(Rules.shot_points(Vector3(0, 0, -3)) == 2)
	assert(Rules.shot_points(Vector3(0, 0, 2)) == 3)
	assert(not Rules.is_clear(Vector3(0, 0, -3)))
	assert(Rules.is_clear(Vector3(0, 0, 2)))
	assert(Rules.shot_probability(4, 0, false) > Rules.shot_probability(4, 0.8, false))
	assert(Rules.shot_probability(4, 0, false) > Rules.shot_probability(4, 0, true))
	assert(Rules.winner([10, 9], 12, true) == -1)
	assert(Rules.winner([11, 9], 12, true) == 0)
	assert(Rules.winner([9, 11], 12, true) == 1)
	assert(Rules.winner([9, 9], 0, true) == -1)
	assert(Rules.winner([9, 8], 0, false) == -1)
	assert(Rules.winner([9, 8], 0, true) == 0)
	assert(Rules.can_steal(Vector3(0, 0, 1), Vector3.ZERO, Vector3.BACK))
	assert(not Rules.can_steal(Vector3(0, 0, -1), Vector3.ZERO, Vector3.BACK))
	assert(not Rules.can_steal(Vector3(0, 0, 2), Vector3.ZERO, Vector3.BACK))
	print("PASS: scoring range, clearing, contest, end-of-game and steal facing")
	quit()
